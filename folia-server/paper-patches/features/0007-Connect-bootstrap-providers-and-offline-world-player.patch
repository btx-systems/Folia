+++ b/src/main/java/org/bukkit/craftbukkit/CraftOfflinePlayer.java
@@ -224,7 +224,7 @@ public class CraftOfflinePlayer implements OfflinePlayer, ConfigurationSerializa
         if (data != null) {
             return data.getLong("firstPlayed").orElseGet(() -> {
                 File file = this.getDataFile();
-                return file.lastModified();
+                return io.nzsmp.folia.storage.PluginPersistence.playerEnabled() ? io.nzsmp.folia.storage.PluginPersistence.playerModified(this.getUniqueId()) : file.lastModified();
             });
         } else {
             return 0;
@@ -241,7 +241,7 @@ public class CraftOfflinePlayer implements OfflinePlayer, ConfigurationSerializa
         if (data != null) {
             return data.getLong("lastPlayed").orElseGet(() -> {
                 File file = this.getDataFile();
-                return file.lastModified();
+                return io.nzsmp.folia.storage.PluginPersistence.playerEnabled() ? io.nzsmp.folia.storage.PluginPersistence.playerModified(this.getUniqueId()) : file.lastModified();
             });
         } else {
             return 0;
@@ -264,7 +264,7 @@ public class CraftOfflinePlayer implements OfflinePlayer, ConfigurationSerializa
             return data.getLong("LastLogin").orElseGet(() -> {
                 // if the player file cannot provide accurate data, this is probably the closest we can approximate
                 File file = getDataFile();
-                return file.lastModified();
+                return io.nzsmp.folia.storage.PluginPersistence.playerEnabled() ? io.nzsmp.folia.storage.PluginPersistence.playerModified(this.getUniqueId()) : file.lastModified();
             });
         } else {
             return 0;
@@ -282,7 +282,7 @@ public class CraftOfflinePlayer implements OfflinePlayer, ConfigurationSerializa
             return data.getLong("LastSeen").orElseGet(() -> {
                 // if the player file cannot provide accurate data, this is probably the closest we can approximate
                 File file = getDataFile();
-                return file.lastModified();
+                return io.nzsmp.folia.storage.PluginPersistence.playerEnabled() ? io.nzsmp.folia.storage.PluginPersistence.playerModified(this.getUniqueId()) : file.lastModified();
             });
         } else {
             return 0;
diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index c1f7510917ebe606280c63d6150829fb0562f474..0174077bdcc992b413171dba6854a9d6766e99ea 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -2206,6 +2206,11 @@ public final class CraftServer implements Server {
 
     @Override
     public OfflinePlayer[] getOfflinePlayers() {
+        if (io.nzsmp.folia.storage.PluginPersistence.playerEnabled()) {
+            final Set<OfflinePlayer> result = new HashSet<>(this.getOnlinePlayers());
+            io.nzsmp.folia.storage.PluginPersistence.playerIds().forEach(id -> result.add(this.getOfflinePlayer(id)));
+            return result.toArray(OfflinePlayer[]::new);
+        }
         PlayerDataStorage storage = this.console.getPlayerList().playerIo;
         String[] files = storage.getPlayerDir().list((dir, name) -> name.endsWith(".dat"));
         Set<OfflinePlayer> players = new HashSet<>();

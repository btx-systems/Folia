+++ b/src/main/java/io/papermc/paper/world/migration/WorldFolderMigration.java
@@ -44,7 +44,7 @@ public final class WorldFolderMigration {
         final ResourceKey<LevelStem> stemKey,
         final ResourceKey<Level> dimensionKey
     ) throws IOException {
-        if (io.nzsmp.folia.storage.PluginPersistence.worldEnabled()) return; // NZSMP - custom stores have no vanilla folders to migrate
+        if (sh.btx.nzsmp.folia.storage.PluginPersistence.worldEnabled()) return; // NZSMP - custom stores have no vanilla folders to migrate
 
         final WorldMigrationContext context = new WorldMigrationContext(rootAccess, registryAccess, worldName, stemKey, dimensionKey);
         final MigrationMode mode = classifyStartupMigration(context);

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: btx-systems <jappleid441@gmail.com>
Date: Tue, 27 Oct 2026 17:04:30 +1300
Subject: [PATCH] Reject corrupt plugin palettes and release login prefetch
 records


diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/task/ChunkLoadTask.java b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/task/ChunkLoadTask.java
index 1df758fd792ae11f3a60eb88fdd79e30f634487c..4b4344c839411cd8bf1bcfa21af1dfbaa58e58c3 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/task/ChunkLoadTask.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/task/ChunkLoadTask.java
@@ -345,7 +345,7 @@ public final class ChunkLoadTask extends ChunkProgressionTask {
 
                 // unpack the data
                 final SerializableChunkData chunkData = SerializableChunkData.parse(
-                    this.world, this.world.palettedContainerFactory(), converted
+                    this.world, this.world.palettedContainerFactory(), converted, io.nzsmp.folia.storage.PluginPersistence.worldEnabled()
                 );
 
                 if (chunkData == null) {
diff --git a/net/minecraft/server/network/config/PrepareSpawnTask.java b/net/minecraft/server/network/config/PrepareSpawnTask.java
index b7370f97ce0720c24ff62ace96ad5ffd041ae6fc..65c5e2da5ad82d4a8818c0888fd3529bc803b428 100644
--- a/net/minecraft/server/network/config/PrepareSpawnTask.java
+++ b/net/minecraft/server/network/config/PrepareSpawnTask.java
@@ -54,7 +54,7 @@ public class PrepareSpawnTask implements ConfigurationTask {
     @Override
     public void start(final Consumer<Packet<?>> connection) {
         if (io.nzsmp.folia.storage.PluginPersistence.playerEnabled()) {
-            this.pluginStorageLoad = io.nzsmp.folia.storage.PluginPersistence.preloadPlayer(this.nameAndId.id());
+            this.pluginStorageLoad = io.nzsmp.folia.storage.PluginPersistence.preloadPlayer(this.nameAndId.id(), this.listener::isAcceptingMessages);
             return;
         }
         this.startAfterStorage();
@@ -204,6 +204,9 @@ public class PrepareSpawnTask implements ConfigurationTask {
     }
 
     public void close() {
+        if (this.pluginStorageLoad != null) this.pluginStorageLoad.cancel(false);
+        this.pluginStorageLoad = null;
+        io.nzsmp.folia.storage.PluginPersistence.releasePlayer(this.nameAndId.id());
         if (this.state instanceof PrepareSpawnTask.Preparing preparing) {
             preparing.cancel();
         }
@@ -390,6 +393,7 @@ public class PrepareSpawnTask implements ConfigurationTask {
                     player.loadAndSpawnEnderPearls(tag);
                     player.loadAndSpawnParentVehicle(tag);
                 });
+                io.nzsmp.folia.storage.PluginPersistence.releasePlayer(player.getUUID()); // NZSMP - login-only cache
                 return player;
             }
         }
diff --git a/net/minecraft/world/level/chunk/storage/SerializableChunkData.java b/net/minecraft/world/level/chunk/storage/SerializableChunkData.java
index f40a1d56d7c5e47d20bce5fe7ea0e29a1afeadec..1a6b4f6185178e745e2deece19ad8ac88aa6ce1c 100644
--- a/net/minecraft/world/level/chunk/storage/SerializableChunkData.java
+++ b/net/minecraft/world/level/chunk/storage/SerializableChunkData.java
@@ -128,6 +128,12 @@ public record SerializableChunkData(
     public static SerializableChunkData parse(
         final LevelHeightAccessor levelHeight, final PalettedContainerFactory containerFactory, final CompoundTag chunkData
     ) {
+        return parse(levelHeight, containerFactory, chunkData, false);
+    }
+
+    // NZSMP - plugin records must not silently promote malformed palettes to default terrain.
+    public static SerializableChunkData parse(final LevelHeightAccessor levelHeight,
+        final PalettedContainerFactory containerFactory, final CompoundTag chunkData, final boolean strict) {
         net.minecraft.server.level.ServerLevel serverLevel = (net.minecraft.server.level.ServerLevel) levelHeight; // Paper - Anti-Xray This is is seemingly only called from ChunkMap, where, we have a server level. We'll fight this later if needed.
         if (chunkData.getString("Status").isEmpty()) {
             return null;
@@ -177,7 +183,10 @@ public record SerializableChunkData(
         List<CompoundTag> entities = chunkData.getList("entities").stream().flatMap(ListTag::compoundStream).toList();
         List<CompoundTag> blockEntities = chunkData.getList("block_entities").stream().flatMap(ListTag::compoundStream).toList();
         CompoundTag structureData = chunkData.getCompoundOrEmpty("structures");
+        if (strict && chunkData.contains("sections") && chunkData.getList("sections").isEmpty()) throw new ChunkReadException("Invalid sections list");
+        final java.util.Set<Integer> seenSections = strict ? new java.util.HashSet<>() : null;
         ListTag sectionTags = chunkData.getListOrEmpty("sections");
+        if (strict && sectionTags.stream().anyMatch(section -> !(section instanceof CompoundTag))) throw new ChunkReadException("Invalid section entry");
         List<SerializableChunkData.SectionData> sectionData = new ArrayList<>(sectionTags.size());
         Codec<PalettedContainer<Holder<Biome>>> biomesCodec = containerFactory.biomeContainerRWCodec(); // CraftBukkit - read/write
         Codec<PalettedContainer<BlockState>> blockStatesCodec = containerFactory.blockStatesContainerCodec();
@@ -187,22 +196,25 @@ public record SerializableChunkData(
             if (!maybeSectionTag.isEmpty()) {
                 CompoundTag sectionTag = maybeSectionTag.get();
                 int y = sectionTag.getByteOr("Y", (byte)0);
+                if (strict && (sectionTag.getByte("Y").isEmpty() || !seenSections.add(y)
+                    || y < levelHeight.getMinSectionY() - 1 || y > levelHeight.getMaxSectionY() + 1
+                    || ((y < levelHeight.getMinSectionY() || y > levelHeight.getMaxSectionY()) && sectionTag.contains("block_states"))
+                    || (sectionTag.contains("block_states") && sectionTag.getCompound("block_states").isEmpty())
+                    || (sectionTag.contains("biomes") && sectionTag.getCompound("biomes").isEmpty()))) {
+                    throw new ChunkReadException("Invalid, duplicate or out-of-bounds section: " + y);
+                }
                 LevelChunkSection section;
                 if (y >= levelHeight.getMinSectionY() && y <= levelHeight.getMaxSectionY()) {
                     final BlockState[] presetBlockStates = serverLevel.chunkPacketBlockController.getPresetBlockStates(serverLevel, chunkPos, y); // Paper - Anti-Xray - Add preset block states
                     final Codec<PalettedContainer<BlockState>> antiXrayBlockStateCodec = presetBlockStates == null ? blockStatesCodec : PalettedContainer.codecRW(BlockState.CODEC, containerFactory.blockStatesStrategy(), net.minecraft.world.level.block.Blocks.AIR.defaultBlockState(), presetBlockStates); // Paper - Anti-Xray
                     PalettedContainer<BlockState> blocks = sectionTag.getCompound("block_states")
                         .map(
-                            container -> antiXrayBlockStateCodec.parse(NbtOps.INSTANCE, container) // Paper - Anti-Xray
-                                .promotePartial(msg -> logErrors(chunkPos, y, msg))
-                                .getOrThrow(SerializableChunkData.ChunkReadException::new)
+                            container -> resolvePaletteResult(antiXrayBlockStateCodec.parse(NbtOps.INSTANCE, container), chunkPos, y, strict) // Paper - Anti-Xray; NZSMP - strict plugin data
                         )
                         .orElseGet(containerFactory::createForBlockStates);
                     PalettedContainer<Holder<Biome>> biomes = sectionTag.getCompound("biomes") // CraftBukkit - read/write
                         .map(
-                            container -> biomesCodec.parse(NbtOps.INSTANCE, container)
-                                .promotePartial(msg -> logErrors(chunkPos, y, msg))
-                                .getOrThrow(SerializableChunkData.ChunkReadException::new)
+                            container -> resolvePaletteResult(biomesCodec.parse(NbtOps.INSTANCE, container), chunkPos, y, strict)
                         )
                         .orElseGet(containerFactory::createForBiomes);
                     section = new LevelChunkSection(blocks, biomes);
@@ -416,6 +428,13 @@ public record SerializableChunkData(
         return this.loadStarlightLightData(level, protoChunk); // Paper - starlight
     }
 
+    // NZSMP - shared strictness boundary, also exercised with malformed codec fixtures.
+    public static <T> T resolvePaletteResult(final com.mojang.serialization.DataResult<T> result,
+        final ChunkPos pos, final int sectionY, final boolean strict) {
+        return (strict ? result : result.promotePartial(message -> logErrors(pos, sectionY, message)))
+            .getOrThrow(ChunkReadException::new);
+    }
+
     private static void logErrors(final ChunkPos pos, final int sectionY, final String message) {
         LOGGER.error("Recoverable errors when loading section [{}, {}, {}]: {}", pos.x(), sectionY, pos.z(), message);
     }
